%% Main Tas
x = 1:32;
y = x.^2;

plot(x,y,'o-r', x,y, 'xb')
title('Dvi Funkcijos')
xlabel('X-ai')
ylabel('F_1 [-o-]    |   F_2 [-x-]')

%% complementary task

N = 5; 

vec = (N + 1) : 0.5 : (N + 4);
% matrix
A = [N,     N+1,   N+2; ...
    N+3,   N+4,   N+5; ...
    N+6,   N+7,   N+8];

% 4. matrix element extraction
a = A(1, :);       % first row
b = A(:, 2);       % second column
c = A(2:3, 2:3);   % 2x2 submatrix (bottom-right)

% 5. Concatenate Matrix A with Vector
% Vector needs 3 
vec_sub = vec(1:3); % Take first 3 elements of vec

% column-wise concatenation (adds as 4th column):
A_concatenated_col = [A, vec_sub']; 

% row-wise concatenation (adds as 4th row):
A_concatenated_row = [A; vec_sub];